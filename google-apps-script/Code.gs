function safeFileName(name){return String(name||"file").replace(/[\\\/:*?"<>|#\[\]]/g," ").replace(/\s+/g," ").trim()||"file"}
function getNamedSheet(name,headers){var ss=SpreadsheetApp.openById(SHEET_ID),s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);ensureHeaderRow(s,headers);return s}
function findSheet(names){var ss=SpreadsheetApp.openById(SHEET_ID);for(var i=0;i<names.length;i++){var s=ss.getSheetByName(names[i]);if(s)return s}return null}
function ensureHeaderRow(sheet,headers){var rg=sheet.getRange(1,1,1,headers.length),v=rg.getValues()[0],ok=true;for(var i=0;i<headers.length;i++){if(v[i]!==headers[i]){ok=false;break}}if(!ok)rg.setValues([headers])}
function normalizeHeaderKey(value){return String(value||"").replace(/\s+/g,"").replace(/[()\/_\-.]/g,"").toLowerCase()}
function headerMap(headers){var m={};for(var i=0;i<headers.length;i++)m[normalizeHeaderKey(headers[i])]=i;return m}
function pick(row,map,names){for(var i=0;i<names.length;i++){var k=normalizeHeaderKey(names[i]);if(map[k]!==undefined)return row[map[k]]}return""}
function getNextCustomerNo(customers){var max=0;for(var i=0;i<customers.length;i++)max=Math.max(max,Number(customers[i].no)||0);return max+1}
function parseRequestBody(e){if(!e||!e.postData||!e.postData.contents)return{};try{return JSON.parse(e.postData.contents)}catch(err){throw new Error("Invalid JSON body")}}
function parseJsonArray(value){try{var a=JSON.parse(String(value||"[]"));return Array.isArray(a)?a:[]}catch(err){return[]}}
function jsonResponse(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
function getErrorMessage(error){return error&&error.message?String(error.message):"Apps Script error"}
function isValidRowIndex(rowIndex){return rowIndex===Math.floor(rowIndex)&&rowIndex>1}
function formatDate(value){return Object.prototype.toString.call(value)==="[object Date]"?Utilities.formatDate(value,TIME_ZONE,"dd/MM/yyyy"):String(value||"")}
function formatDateTime(value){return Object.prototype.toString.call(value)==="[object Date]"?Utilities.formatDate(value,TIME_ZONE,"yyyy-MM-dd HH:mm:ss"):String(value||"")}
function maxText(a,b){return String(b||"")>String(a||"")?String(b||""):String(a||"")}
function toNumberOrNull(value){if(value===""||value===null||value===undefined)return null;var n=Number(value);return isNaN(n)?null:n}
function normalizePlate(value){return String(value||"").replace(/\s+/g,"").toUpperCase()}
