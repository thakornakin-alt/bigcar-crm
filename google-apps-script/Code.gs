function cleanSalesUserInput(input){var u={email:normalizeEmail(input.email),password:String(input.password||""),firstName:String(input.firstName||"").trim(),lastName:String(input.lastName||"").trim(),nickname:String(input.nickname||"").trim(),phone:String(input.phone||"").trim(),lineId:String(input.lineId||"").trim(),lineQrUrl:String(input.lineQrUrl||"").trim(),avatarUrl:String(input.avatarUrl||"").trim(),position:String(input.position||"Sales").trim(),branch:String(input.branch||"").trim()};if(!u.email||u.email.indexOf("@")<0)throw new Error("Email ไม่ถูกต้อง");if(u.password.length<6)throw new Error("Password อย่างน้อย 6 ตัว");if(!u.firstName||!u.lastName||!u.nickname||!u.phone||!u.branch)throw new Error("กรอก ชื่อ นามสกุล ชื่อเล่น เบอร์โทร และสาขา");return u}
function findSalesUserByEmail(email){var e=normalizeEmail(email),s=getSalesUserSheet(),last=s.getLastRow();if(!e||last<=1)return null;var rows=s.getRange(2,1,last-1,SALES_USER_HEADERS.length).getValues();for(var i=0;i<rows.length;i++){if(normalizeEmail(rows[i][3])===e)return{row:rows[i],rowIndex:i+2}}return null}
function findSalesUserById(id){var safe=String(id||""),s=getSalesUserSheet(),last=s.getLastRow();if(!safe||last<=1)return null;var rows=s.getRange(2,1,last-1,SALES_USER_HEADERS.length).getValues();for(var i=0;i<rows.length;i++){if(String(rows[i][0])===safe)return{row:rows[i],rowIndex:i+2}}return null}
function salesUserFromRow(r){return{id:String(r[0]||""),createdAt:String(r[1]||""),updatedAt:String(r[2]||""),email:String(r[3]||""),firstName:String(r[6]||""),lastName:String(r[7]||""),nickname:String(r[8]||""),phone:String(r[9]||""),lineId:String(r[10]||""),lineQrUrl:String(r[11]||""),avatarUrl:String(r[12]||""),position:String(r[13]||""),branch:String(r[14]||""),role:String(r[15]||"sales"),locked:r[16]===true||String(r[16]).toUpperCase()==="TRUE"}}
function getSalesUserSheet(){return getNamedSheet(SALES_USERS_SHEET_NAME,SALES_USER_HEADERS)}
function hashPassword(password,salt){var bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(salt)+"|"+String(password),Utilities.Charset.UTF_8);return bytesToHex(bytes)}
function bytesToHex(bytes){var out="";for(var i=0;i<bytes.length;i++){var b=bytes[i];if(b<0)b+=256;out+=(b<16?"0":"")+b.toString(16)}return out}
function normalizeEmail(value){return String(value||"").trim().toLowerCase()}
